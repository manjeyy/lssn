<mxfile host="65bd71144e">
    <diagram id="fe1-auth" name="FE1 Auth Lifecycle">
        <mxGraphModel dx="1220" dy="448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="User submits register or login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="60" y="120" width="230" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="POST /auth/register or /auth/login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="340" y="120" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Credentials valid and user exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="650" y="110" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Return 401 or 409 error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="1000" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="Issue access token + refresh token&#xa;Store refresh session hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="970" y="100" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="Client stores tokens&#xa;localStorage/cookies or AsyncStorage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="160" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="API call with Bearer access token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="340" y="280" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="401 Unauthorized?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="650" y="380" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="POST /auth/refresh&#xa;Rotate session + new tokens" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="910" y="280" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="Retry original request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="310" width="220" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="POST /auth/logout&#xa;Revoke refresh session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="920" y="450" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="Client clears tokens" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="450" width="220" height="60" as="geometry"/>
                </mxCell>
